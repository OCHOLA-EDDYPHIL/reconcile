{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lazarus.case/v1",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "split",
    "artifacts",
    "recovery",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "lazarus.case/v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "calibration",
        "heldout"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "kind",
          "path",
          "authority"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": [
              "structured_fact",
              "declared_context",
              "advisory_context"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "recovery": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
