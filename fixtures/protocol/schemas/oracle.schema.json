{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lazarus.oracle/v1",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "negative_control",
    "decision_changing_blockers",
    "coverage",
    "abstention_required",
    "required_probe",
    "recovery_expectation"
  ],
  "properties": {
    "schema_version": {
      "const": "lazarus.oracle/v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "negative_control": {
      "type": "boolean"
    },
    "decision_changing_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "oracle_id",
          "decision_changing",
          "acceptable_matches"
        ],
        "properties": {
          "oracle_id": {
            "type": "string",
            "minLength": 1
          },
          "decision_changing": {
            "const": true
          },
          "acceptable_matches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "minProperties": 1
                }
              ]
            }
          },
          "required_relation_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "intent_effect_contradiction",
                "resource_alias_candidate",
                "conditional_dependency_candidate",
                "owner_candidate",
                "incident_relevance_advisory",
                "probe_selection"
              ]
            }
          },
          "requires_abstention": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "advisory_findings": {
      "type": "array"
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "abstention_required": {
      "type": "boolean"
    },
    "required_probe": {
      "type": [
        "string",
        "null"
      ]
    },
    "recovery_expectation": {
      "type": "object",
      "required": [
        "restore",
        "canary",
        "rpo",
        "rto",
        "cleanup"
      ],
      "properties": {
        "restore": {"enum": ["pass", "fail", "unknown"]},
        "canary": {"enum": ["pass", "fail", "unknown"]},
        "rpo": {"enum": ["pass", "fail", "unknown"]},
        "rto": {"enum": ["pass", "fail", "unknown"]},
        "cleanup": {"enum": ["pass", "fail", "unknown"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
