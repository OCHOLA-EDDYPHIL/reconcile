digraph ReconcileDeployment {
  graph [
    bgcolor="#07111f",
    fontname="Liberation Sans",
    label=<<FONT POINT-SIZE="32"><B>RECONCILE</B> — GOOGLE CLOUD TRUST TOPOLOGY</FONT><BR/><FONT POINT-SIZE="18">Operational authority is isolated from the static evidence viewer.</FONT>>,
    labelloc="t",
    labeljust="l",
    fontcolor="#f8fafc",
    pad=0.42,
    rankdir=TB,
    ranksep=1.18,
    nodesep=0.58,
    newrank=true,
    ratio=fill,
    size="14.3,8.0!",
    splines=polyline,
    compound=true
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Liberation Sans",
    fontsize=18,
    fontcolor="#e2e8f0",
    color="#60a5fa",
    fillcolor="#13253d",
    margin="0.22,0.17",
    penwidth=1.7
  ];
  edge [
    fontname="Liberation Sans",
    fontsize=14,
    fontcolor="#cbd5e1",
    color="#64748b",
    arrowsize=0.80,
    penwidth=1.7
  ];

  subgraph cluster_core {
    label="OPERATIONAL CORE • SEPARATE SERVICE IDENTITIES";
    fontname="Liberation Sans";
    fontsize=18;
    fontcolor="#cbd5e1";
    color="#475569";
    style="rounded";
    margin=20;

    api [label="CLOUD RUN API\nAuthenticated entry\nDurable orchestration"];
    controller [
      label="CLOUD RUN CONTROLLER\nAdvisory planning\nEvidence admission and verification"
    ];
    proxy [
      label="CLOUD RUN FAULT PROXY\nPermit-gated mutation\nControlled acknowledgement loss",
      fillcolor="#172554",
      color="#818cf8"
    ];
    target [label="CLOUD RUN TARGET\nStaged release and traffic state"];
    sandbox [label="CLOUD RUN SANDBOX\nIsolated provider-shaped state"];

    { rank=same; api; controller; proxy; }
    { rank=same; target; sandbox; }
    api -> controller [label="investigate"];
    controller -> proxy [label="exact permit", color="#34d399"];
    proxy -> target [label="permitted action", color="#34d399"];
    controller -> sandbox [label="read", style=dashed, color="#38bdf8"];
    proxy -> sandbox [label="mutate", color="#34d399"];
  }

  subgraph cluster_data {
    label="MANAGED SERVICES • LEAST-PRIVILEGE ACCESS";
    fontname="Liberation Sans";
    fontsize=18;
    fontcolor="#cbd5e1";
    color="#475569";
    style="rounded";
    margin=20;

    vertex [
      label="VERTEX AI\nBounded advisory planning",
      shape=component,
      fillcolor="#2e1065",
      color="#c4b5fd"
    ];
    authority [
      label="FIRESTORE AUTHORITY\nRecovery state and permit claims",
      shape=cylinder,
      fillcolor="#082f49",
      color="#38bdf8"
    ];
    provider_state [
      label="PROVIDER STATE\nRelease and sandbox evidence",
      shape=cylinder,
      fillcolor="#082f49",
      color="#38bdf8"
    ];
    custody [
      label="PRIVATE CUSTODY\nOperator records and raw evidence",
      shape=folder,
      fillcolor="#3f2d14",
      color="#fbbf24"
    ];

    { rank=same; authority; vertex; provider_state; custody; }
  }

  subgraph cluster_public {
    label="PUBLIC EVIDENCE SURFACE • NO OPERATIONAL AUTHORITY";
    fontname="Liberation Sans";
    fontsize=18;
    fontcolor="#cbd5e1";
    color="#475569";
    style="rounded";
    margin=20;

    versioned [
      label="VERSIONED EVIDENCE\nSanitized immutable files",
      shape=folder,
      fillcolor="#3f2d14",
      color="#fbbf24"
    ];
    viewer [
      label="CLOUD RUN VIEWER\nStatic HTML and JSON\nRead-only routes",
      fillcolor="#1f2937",
      color="#94a3b8"
    ];
    public [label="PUBLIC READER\nBrowser or offline verifier"];

    versioned -> viewer [label="bundled at build time", style=dashed];
    viewer -> public [label="read-only response", dir=back];
  }

  controller -> vertex [label="advisory request", color="#a78bfa"];
  controller -> authority [label="authority state", color="#38bdf8"];
  controller -> provider_state [label="evidence reads", color="#38bdf8"];
  proxy -> provider_state [label="permitted write", color="#34d399"];
  custody -> versioned [label="sanitized export", style=dashed, color="#fbbf24"];
}
