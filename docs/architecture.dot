digraph ReconcileArchitecture {
  graph [
    bgcolor="#07111f",
    fontname="Arial",
    label="RECONCILE — Proof-to-Permit authority flow",
    labelloc="t",
    labeljust="l",
    fontcolor="#f8fafc",
    fontsize=22,
    pad=0.35,
    ranksep=0.65,
    nodesep=0.35,
    splines=polyline
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=11,
    fontcolor="#e2e8f0",
    color="#475569",
    fillcolor="#111c2e",
    margin="0.14,0.10"
  ];
  edge [fontname="Arial", fontsize=9, fontcolor="#cbd5e1", color="#64748b", arrowsize=0.75];

  rollout [label="1  RolloutAgent\nexact release intent", fillcolor="#13253d"];
  gate [label="2 / 8  deterministic dispatch gate\nrequires matching unspent permit", fillcolor="#172554", color="#818cf8"];
  proxy [label="Tool / fault proxy\ndurable dispatch receipt", fillcolor="#172554", color="#818cf8"];
  cloud [label="Google Cloud Run\nstage revision → promote traffic", fillcolor="#082f49", color="#38bdf8"];
  lost [label="3  acknowledgement lost\noutcome is ambiguous", shape=octagon, fillcolor="#451a1a", color="#fb7185"];

  subgraph cluster_advisory {
    label="ADVISORY — cannot authorize a mutation";
    color="#a78bfa";
    fontcolor="#ddd6fe";
    style="rounded,dashed";
    recovery [label="4  RecoveryAgent\nADK-backed Gemini planner", fillcolor="#2e1065", color="#c4b5fd"];
    gemini [label="Gemini 3.5 Flash\nevidence-cited hypothesis + probe proposal", fillcolor="#2e1065", color="#c4b5fd"];
    recovery -> gemini [label="bounded context", color="#a78bfa"];
  }

  subgraph cluster_readonly {
    label="READ-ONLY PROVIDER EVIDENCE";
    color="#38bdf8";
    fontcolor="#bae6fd";
    style="rounded";
    allowlist [label="5  capability allowlist\nbudget + freshness checks", fillcolor="#082f49", color="#38bdf8"];
    probes [label="Cloud Run operation, revision, service\nFirestore release-record read", fillcolor="#082f49", color="#38bdf8"];
    evidence [label="normalized evidence\nsource + time + exact correlation", fillcolor="#082f49", color="#38bdf8"];
    allowlist -> probes -> evidence;
  }

  subgraph cluster_authority {
    label="DETERMINISTIC AUTHORITY";
    color="#34d399";
    fontcolor="#a7f3d0";
    style="rounded";
    verifier [label="6  deterministic verifier\nclassification + declared effects", fillcolor="#052e2b", color="#34d399"];
    witness [label="ambiguity witness\nHOLD — no mutation", fillcolor="#3f1d2e", color="#fb7185"];
    certificate [label="verified certificate\nexact transition + evidence hash", fillcolor="#052e2b", color="#34d399"];
    permits [label="7  Firestore permit store\nexact action • expiry • max_uses=1", fillcolor="#052e2b", color="#34d399"];
    verifier -> witness [label="stale / missing / conflict", color="#fb7185"];
    verifier -> certificate [label="all effects established", color="#34d399"];
    certificate -> permits [label="issue exact permit", color="#34d399"];
  }

  record [label="Firestore release record\ncreate exactly once for release ID", fillcolor="#082f49", color="#38bdf8"];
  replay [label="9  consumed permit replay\nrejected before provider contact", shape=octagon, fillcolor="#451a1a", color="#fb7185"];

  rollout -> gate [label="launch authority"];
  gate -> proxy [label="claim once"];
  proxy -> cloud [label="stage"];
  cloud -> lost [label="response dropped", color="#fb7185"];
  lost -> recovery [label="reconcile; do not guess", color="#fbbf24"];
  gemini -> allowlist [label="propose safe reads", color="#a78bfa"];
  evidence -> verifier [label="admitted facts", color="#34d399"];
  permits -> gate [label="continue / retry permit", color="#34d399"];
  proxy -> cloud [label="promote", color="#34d399"];
  proxy -> record [label="persist completion", color="#34d399"];
  gate -> replay [label="already consumed", color="#fb7185"];
}
