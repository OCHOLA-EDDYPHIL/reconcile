digraph ReconcileArchitecture {
  graph [
    bgcolor="#07111f",
    fontname="Liberation Sans",
    label=<<FONT POINT-SIZE="32"><B>RECONCILE</B> — RECOVERY AUTHORITY</FONT><BR/><FONT POINT-SIZE="18">Advisory investigation proposes evidence. Deterministic verification authorizes action.</FONT>>,
    labelloc="t",
    labeljust="l",
    fontcolor="#f8fafc",
    pad=0.42,
    rankdir=TB,
    ranksep=0.76,
    nodesep=0.86,
    newrank=true,
    splines=polyline
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Liberation Sans",
    fontsize=19,
    fontcolor="#e2e8f0",
    color="#475569",
    fillcolor="#111c2e",
    margin="0.25,0.19",
    penwidth=1.8
  ];
  edge [
    fontname="Liberation Sans",
    fontsize=15,
    fontcolor="#cbd5e1",
    color="#64748b",
    arrowsize=0.85,
    penwidth=1.8
  ];

  fault [
    label="1  LOST ACKNOWLEDGEMENT\nThe provider outcome is unknown.",
    shape=octagon,
    fillcolor="#451a1a",
    color="#fb7185",
    group="left"
  ];
  advisory [
    label="2  RECOVERY AGENT\nADK + Gemini propose a hypothesis\nand bounded read-only probes.\nAdvisory only.",
    fillcolor="#2e1065",
    color="#c4b5fd",
    group="right"
  ];
  evidence [
    label="3  EVIDENCE GATE\nAllowlisted sources • read budget\nprovenance • freshness • correlation",
    fillcolor="#082f49",
    color="#38bdf8",
    group="left"
  ];
  verifier [
    label="4  DETERMINISTIC VERIFIER\nAdmitted facts only.\nUNKNOWN → HOLD\nProved effect → certificate",
    fillcolor="#052e2b",
    color="#34d399",
    group="right"
  ];
  permit [
    label="5  EXACT PERMIT\nOne semantic action • expiry\nmax_uses=1 • durable Firestore CAS",
    fillcolor="#052e2b",
    color="#34d399",
    group="right"
  ];
  dispatch [
    label="6  GUARDED DISPATCH\nClaim before provider contact.\nConsumed replay is denied pre-contact.",
    fillcolor="#172554",
    color="#818cf8",
    group="left"
  ];

  { rank=same; fault; advisory; }
  { rank=same; evidence; verifier; }
  { rank=same; dispatch; permit; }

  fault -> evidence [style=invis, weight=100];
  evidence -> dispatch [style=invis, weight=100];
  advisory -> verifier [style=invis, weight=100];

  fault -> advisory [label="reconcile", color="#fbbf24", weight=20];
  advisory -> evidence [label="probe proposal", color="#a78bfa", weight=20];
  evidence -> verifier [label="admitted facts", color="#38bdf8", weight=20];
  verifier -> permit [label="verified certificate", color="#34d399", weight=20];
  dispatch -> permit [label="atomic claim", color="#34d399", dir=back, weight=20];
}
