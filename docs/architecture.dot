digraph ReconcileArchitecture {
  graph [
    bgcolor="#07111f",
    fontname="Liberation Sans",
    label=<<FONT POINT-SIZE="34"><B>Reconcile</B> — RECOVERY AUTHORITY</FONT><BR/><FONT POINT-SIZE="20">Advisory investigation proposes evidence. Deterministic verification controls action.</FONT>>,
    labelloc="t",
    labeljust="l",
    fontcolor="#f8fafc",
    pad=0.42,
    rankdir=TB,
    ranksep=0.88,
    nodesep=0.48,
    newrank=true,
    ratio=fill,
    size="14.3,8.0!",
    splines=polyline
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Liberation Sans",
    fontsize=21,
    fontcolor="#e2e8f0",
    color="#475569",
    fillcolor="#111c2e",
    margin="0.23,0.17",
    penwidth=1.8
  ];
  edge [
    fontname="Liberation Sans",
    fontsize=16,
    fontcolor="#cbd5e1",
    color="#64748b",
    arrowsize=0.82,
    penwidth=1.8
  ];

  fault [
    label="LOST ACKNOWLEDGEMENT\nProvider outcome is uncertain",
    shape=octagon,
    fillcolor="#451a1a",
    color="#fb7185"
  ];
  advisory [
    label="RECOVERY AGENT\nGemini proposes a hypothesis\nand bounded read-only probes\nAdvisory only",
    fillcolor="#2e1065",
    color="#c4b5fd"
  ];
  evidence [
    label="EVIDENCE GATE\nAllowlisted sources and reads\nProvenance • freshness • correlation",
    fillcolor="#082f49",
    color="#38bdf8"
  ];
  verifier [
    label="DETERMINISTIC VERIFIER\nAdmitted facts only\nIncomplete proof stays UNKNOWN",
    fillcolor="#052e2b",
    color="#34d399"
  ];
  observe [
    label="OBSERVE\nAllowlisted read only\nNo mutation permit",
    fillcolor="#082f49",
    color="#38bdf8"
  ];
  escalate [
    label="ESCALATE\nAmbiguity witness\nNo mutation authority",
    fillcolor="#451a1a",
    color="#fb7185"
  ];
  permit [
    label="RETRY OR CONTINUE\nCertificate-bound permit\nExact • expiring • single-use",
    fillcolor="#052e2b",
    color="#34d399"
  ];
  dispatch [
    label="GUARDED DISPATCH\nClaim before provider contact\nConsumed replay is denied",
    fillcolor="#172554",
    color="#818cf8"
  ];
  record [
    label="VERSIONED EVIDENCE\nSanitized immutable record",
    fillcolor="#3f2d14",
    color="#fbbf24"
  ];
  viewer [
    label="READ-ONLY VIEWER\nStatic projection\nNo operational connection",
    fillcolor="#1f2937",
    color="#94a3b8"
  ];

  { rank=same; fault; advisory; evidence; verifier; }
  { rank=same; observe; escalate; permit; dispatch; }
  { rank=same; record; viewer; }

  fault -> advisory [label="investigate", color="#fbbf24"];
  advisory -> evidence [label="probe proposal", color="#a78bfa"];
  evidence -> verifier [label="admitted facts", color="#38bdf8"];
  verifier -> observe [label="more evidence", color="#38bdf8"];
  observe -> evidence [label="bounded read", color="#38bdf8"];
  verifier -> escalate [label="unsafe or unresolved", color="#fb7185"];
  verifier -> permit [label="safe mutating step", color="#34d399"];
  permit -> dispatch [label="atomic claim", color="#34d399"];
  escalate -> record [label="record", color="#fbbf24"];
  dispatch -> record [label="record", color="#fbbf24"];
  record -> viewer [label="static export", style=dashed, color="#94a3b8"];
}
