{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lazarus:schema:case:v1",
  "title": "Lazarus case contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "split",
    "artifacts",
    "recovery",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "lazarus.case/v1"
    },
    "case_id": {
      "$ref": "#/$defs/identifier"
    },
    "split": {
      "enum": ["calibration", "heldout"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "authority"],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "terraform_plan",
            "service_manifest",
            "ownership",
            "recovery_ledger",
            "change_ticket",
            "change_ticket_text",
            "pr_description",
            "runbook",
            "incident",
            "history"
          ]
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "authority": {
          "enum": [
            "structured_fact",
            "declared_context",
            "advisory_context"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "terraform_plan",
                  "service_manifest",
                  "ownership",
                  "recovery_ledger"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "structured_fact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["change_ticket", "change_ticket_text", "pr_description", "runbook"]
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "declared_context"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["incident", "history"]
              }
            }
          },
          "then": {
            "properties": {
              "authority": {
                "const": "advisory_context"
              }
            }
          }
        }
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dump_path",
        "backup_created_at",
        "reference_time",
        "rpo_seconds",
        "rto_ms",
        "minimum_delay_ms",
        "expected_schema_version",
        "required_tables",
        "assertions"
      ],
      "properties": {
        "dump_path": {
          "$ref": "#/$defs/relative_path"
        },
        "backup_created_at": {
          "type": "string",
          "format": "date-time"
        },
        "reference_time": {
          "type": "string",
          "format": "date-time"
        },
        "rpo_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "rto_ms": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "expected_schema_version": {
          "type": "integer",
          "minimum": 0
        },
        "required_tables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "simulate_cleanup_failure": {
          "type": "boolean"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "sql", "expected"],
      "properties": {
        "assertion_id": {
          "$ref": "#/$defs/identifier"
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "expected": true
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_time",
        "max_evidence_age_seconds",
        "allowed_probe_ids",
        "required_owner_fields",
        "human_decision_required"
      ],
      "properties": {
        "reference_time": {
          "type": "string",
          "format": "date-time"
        },
        "max_evidence_age_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_probe_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/probe_id"
          }
        },
        "required_owner_fields": {
          "type": "array",
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "const": "owner"
              }
            },
            {
              "contains": {
                "const": "recovery_owner"
              }
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_decision_required": {
          "const": true
        }
      }
    },
    "probe_id": {
      "enum": [
        "verify_resource_generation",
        "verify_recovery_scope",
        "verify_owner_record",
        "run_application_canary"
      ]
    }
  }
}
