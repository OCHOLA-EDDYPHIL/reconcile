{
  "$defs": {
    "RecoveryCloudRunObservation": {
      "additionalProperties": false,
      "properties": {
        "baseline_revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Baseline Revision",
          "type": "string"
        },
        "intended_revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Intended Revision",
          "type": "string"
        },
        "observed_service_etag_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observed Service Etag Sha256",
          "type": "string"
        },
        "release_revisions": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Release Revisions",
          "type": "array"
        },
        "serving_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Serving Percent",
          "type": "integer"
        },
        "serving_revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Serving Revision",
          "type": "string"
        }
      },
      "required": [
        "baseline_revision",
        "intended_revision",
        "release_revisions",
        "serving_revision",
        "serving_percent",
        "observed_service_etag_sha256"
      ],
      "title": "RecoveryCloudRunObservation",
      "type": "object"
    },
    "RecoveryDispatchReceipt": {
      "additionalProperties": false,
      "description": "Durable dispatcher fact bound to one claimed-authority attempt.",
      "properties": {
        "action_request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Request Sha256",
          "type": "string"
        },
        "attempt": {
          "maximum": 2,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "authority_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Authority Id",
          "type": "string"
        },
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/RecoveryReceiptOutcome"
        },
        "provider_contact": {
          "title": "Provider Contact",
          "type": "boolean"
        },
        "receipt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Receipt Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Release Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "reconcile/recovery-dispatch-receipt/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_action_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Action Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "receipt_id",
        "run_id",
        "release_id",
        "node_id",
        "semantic_action_sha256",
        "action_request_sha256",
        "authority_id",
        "claim_id",
        "attempt",
        "provider_contact",
        "outcome",
        "recorded_at"
      ],
      "title": "RecoveryDispatchReceipt",
      "type": "object"
    },
    "RecoveryFirestoreObservation": {
      "additionalProperties": false,
      "properties": {
        "cloud_run_revision": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cloud Run Revision"
        },
        "document_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Document Path",
          "type": "string"
        },
        "exists": {
          "title": "Exists",
          "type": "boolean"
        },
        "expected_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Payload Sha256",
          "type": "string"
        },
        "expected_semantic_action_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Semantic Action Sha256",
          "type": "string"
        },
        "payload_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Sha256"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Release Id",
          "type": "string"
        },
        "semantic_action_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Action Sha256"
        }
      },
      "required": [
        "release_id",
        "document_path",
        "expected_payload_sha256",
        "expected_semantic_action_sha256",
        "exists"
      ],
      "title": "RecoveryFirestoreObservation",
      "type": "object"
    },
    "RecoveryMutationCounters": {
      "additionalProperties": false,
      "properties": {
        "action_permits_consumed": {
          "maximum": 16,
          "minimum": 0,
          "title": "Action Permits Consumed",
          "type": "integer"
        },
        "continue_permits_issued": {
          "maximum": 16,
          "minimum": 0,
          "title": "Continue Permits Issued",
          "type": "integer"
        },
        "promotions_accepted": {
          "maximum": 16,
          "minimum": 0,
          "title": "Promotions Accepted",
          "type": "integer"
        },
        "provider_contacts": {
          "maximum": 64,
          "minimum": 0,
          "title": "Provider Contacts",
          "type": "integer"
        },
        "release_records_created": {
          "maximum": 16,
          "minimum": 0,
          "title": "Release Records Created",
          "type": "integer"
        },
        "retry_permits_consumed": {
          "maximum": 2,
          "minimum": 0,
          "title": "Retry Permits Consumed",
          "type": "integer"
        },
        "retry_permits_issued": {
          "maximum": 2,
          "minimum": 0,
          "title": "Retry Permits Issued",
          "type": "integer"
        },
        "revisions_created": {
          "maximum": 16,
          "minimum": 0,
          "title": "Revisions Created",
          "type": "integer"
        }
      },
      "required": [
        "revisions_created",
        "promotions_accepted",
        "release_records_created",
        "provider_contacts",
        "continue_permits_issued",
        "retry_permits_issued",
        "retry_permits_consumed",
        "action_permits_consumed"
      ],
      "title": "RecoveryMutationCounters",
      "type": "object"
    },
    "RecoveryPolicyResult": {
      "additionalProperties": false,
      "properties": {
        "certificate_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Certificate Sha256S",
          "type": "array"
        },
        "chain_completed": {
          "title": "Chain Completed",
          "type": "boolean"
        },
        "cloud_run": {
          "$ref": "#/$defs/RecoveryCloudRunObservation"
        },
        "counters": {
          "$ref": "#/$defs/RecoveryMutationCounters"
        },
        "dispatch_receipts": {
          "items": {
            "$ref": "#/$defs/RecoveryDispatchReceipt"
          },
          "maxItems": 16,
          "title": "Dispatch Receipts",
          "type": "array"
        },
        "fault": {
          "enum": [
            "no-fault",
            "drop-after-accept",
            "acceptance-drop-after-accept-partial-read-outage",
            "suppress-before-dispatch"
          ],
          "title": "Fault",
          "type": "string"
        },
        "fault_boundary_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fault Boundary Sha256",
          "type": "string"
        },
        "firestore": {
          "$ref": "#/$defs/RecoveryFirestoreObservation"
        },
        "input_intent_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Intent Sha256",
          "type": "string"
        },
        "observation_catalog_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Catalog Sha256",
          "type": "string"
        },
        "policy": {
          "enum": [
            "blind-retry",
            "blind-abort",
            "fixed",
            "adaptive"
          ],
          "title": "Policy",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "reconcile/recovery-policy-result/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Sha256",
          "type": "string"
        },
        "terminal_disposition": {
          "enum": [
            "COMPLETED",
            "ABORTED",
            "ESCALATED"
          ],
          "title": "Terminal Disposition",
          "type": "string"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/RecoveryTimelineEntry"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Timeline",
          "type": "array"
        },
        "witness_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Witness Sha256S",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "policy",
        "fault",
        "target_sha256",
        "input_intent_sha256",
        "fault_boundary_sha256",
        "observation_catalog_sha256",
        "chain_completed",
        "terminal_disposition",
        "counters",
        "cloud_run",
        "firestore",
        "dispatch_receipts",
        "timeline",
        "certificate_sha256s",
        "witness_sha256s"
      ],
      "title": "RecoveryPolicyResult",
      "type": "object"
    },
    "RecoveryReceiptOutcome": {
      "description": "What the trusted dispatcher knew before or after provider contact.",
      "enum": [
        "PROVIDER_CONTACTED",
        "SUPPRESSED_BEFORE_DISPATCH",
        "REJECTED_BEFORE_PROVIDER_CONTACT"
      ],
      "title": "RecoveryReceiptOutcome",
      "type": "string"
    },
    "RecoveryResetResult": {
      "additionalProperties": false,
      "properties": {
        "baseline_revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Baseline Revision",
          "type": "string"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Release Id",
          "type": "string"
        },
        "release_record_absent": {
          "title": "Release Record Absent",
          "type": "boolean"
        },
        "release_revisions_after": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Release Revisions After",
          "type": "array"
        },
        "release_revisions_before": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Release Revisions Before",
          "type": "array"
        },
        "reset_operation_name_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reset Operation Name Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "reconcile/recovery-reset-result/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "serving_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Serving Percent",
          "type": "integer"
        },
        "serving_revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Serving Revision",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "release_id",
        "baseline_revision",
        "serving_revision",
        "serving_percent",
        "release_record_absent",
        "release_revisions_before",
        "release_revisions_after",
        "reset_operation_name_sha256",
        "verified_at"
      ],
      "title": "RecoveryResetResult",
      "type": "object"
    },
    "RecoveryTimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "event": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Event",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 256,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "node_id",
        "event",
        "detail"
      ],
      "title": "RecoveryTimelineEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comparison_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Comparison Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "fault": {
      "enum": [
        "no-fault",
        "drop-after-accept",
        "suppress-before-dispatch"
      ],
      "title": "Fault",
      "type": "string"
    },
    "fault_boundary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fault Boundary Sha256",
      "type": "string"
    },
    "input_intent_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Intent Sha256",
      "type": "string"
    },
    "lanes": {
      "items": {
        "$ref": "#/$defs/RecoveryPolicyResult"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Lanes",
      "type": "array"
    },
    "observation_catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Catalog Sha256",
      "type": "string"
    },
    "release_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Release Id",
      "type": "string"
    },
    "reset_results": {
      "items": {
        "$ref": "#/$defs/RecoveryResetResult"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Reset Results",
      "type": "array"
    },
    "schema_version": {
      "const": "reconcile/recovery-policy-comparison/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "comparison_id",
    "release_id",
    "fault",
    "target_sha256",
    "input_intent_sha256",
    "fault_boundary_sha256",
    "observation_catalog_sha256",
    "lanes",
    "reset_results",
    "created_at"
  ],
  "title": "RecoveryPolicyComparison",
  "type": "object"
}
