{
  "$defs": {
    "Classification": {
      "enum": [
        "COMMITTED",
        "NOT_COMMITTED",
        "PARTIAL",
        "PENDING",
        "UNKNOWN"
      ],
      "title": "Classification",
      "type": "string"
    },
    "DiscriminatingObservation": {
      "additionalProperties": false,
      "properties": {
        "capability_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Name"
        },
        "capability_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Version"
        },
        "description": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "distinguishes_history_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Distinguishes History Ids",
          "type": "array"
        },
        "observation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Observation Id",
          "type": "string"
        },
        "relevant_effect_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Relevant Effect Ids",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "description",
        "distinguishes_history_ids"
      ],
      "title": "DiscriminatingObservation",
      "type": "object"
    },
    "EffectAssertionState": {
      "enum": [
        "ESTABLISHED",
        "NOT_ESTABLISHED",
        "UNVERIFIED"
      ],
      "title": "EffectAssertionState",
      "type": "string"
    },
    "HypothesizedEffect": {
      "additionalProperties": false,
      "properties": {
        "cited_evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Cited Evidence Ids",
          "type": "array"
        },
        "effect_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Effect Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/EffectAssertionState"
        }
      },
      "required": [
        "effect_id",
        "state"
      ],
      "title": "HypothesizedEffect",
      "type": "object"
    },
    "JsonValue": {},
    "NonEmptySmallJsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "maxProperties": 32,
      "minProperties": 1,
      "type": "object"
    },
    "PossibleHistory": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "compatible_evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Compatible Evidence Ids",
          "type": "array"
        },
        "effect_states": {
          "items": {
            "$ref": "#/$defs/HypothesizedEffect"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Effect States",
          "type": "array"
        },
        "history_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "History Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "history_id",
        "classification",
        "effect_states",
        "summary"
      ],
      "title": "PossibleHistory",
      "type": "object"
    },
    "RecoveryEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "raw_observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Observation Sha256",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_sha256",
        "raw_observation_sha256",
        "valid_until"
      ],
      "title": "RecoveryEvidenceBinding",
      "type": "object"
    },
    "TargetBinding": {
      "additionalProperties": false,
      "properties": {
        "resource": {
          "$ref": "#/$defs/NonEmptySmallJsonObject"
        },
        "scope": {
          "$ref": "#/$defs/NonEmptySmallJsonObject"
        },
        "target_kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "target_kind",
        "scope",
        "resource"
      ],
      "title": "TargetBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chain_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Chain Id",
      "type": "string"
    },
    "chain_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Chain Sha256",
      "type": "string"
    },
    "conflicting_evidence_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Conflicting Evidence Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "discriminating_observations": {
      "items": {
        "$ref": "#/$defs/DiscriminatingObservation"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Discriminating Observations",
      "type": "array"
    },
    "envelope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Envelope Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/RecoveryEvidenceBinding"
      },
      "maxItems": 64,
      "title": "Evidence",
      "type": "array"
    },
    "node_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Node Id",
      "type": "string"
    },
    "node_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Node Sha256",
      "type": "string"
    },
    "possible_histories": {
      "items": {
        "$ref": "#/$defs/PossibleHistory"
      },
      "maxItems": 8,
      "minItems": 2,
      "title": "Possible Histories",
      "type": "array"
    },
    "proof_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proof Sha256",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "reconcile/ambiguity-witness/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_action_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Semantic Action Sha256",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/TargetBinding"
    },
    "target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Sha256",
      "type": "string"
    },
    "verifier_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Verifier Version",
      "type": "string"
    },
    "witness_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Witness Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "witness_id",
    "chain_id",
    "node_id",
    "semantic_action_sha256",
    "chain_sha256",
    "node_sha256",
    "envelope_sha256",
    "report_sha256",
    "proof_sha256",
    "target",
    "target_sha256",
    "possible_histories",
    "discriminating_observations",
    "verifier_version",
    "created_at"
  ],
  "title": "AmbiguityWitness",
  "type": "object"
}
