        "unsupported_contract_version",
        "investigation_not_found",
        "duplicate_investigation_id",
        "dependency_unavailable",
        "internal_failure"
      ],
      "title": "ApiErrorCode",
      "type": "string"
    },
    "JsonValue": {},
    "SmallJsonObject": {
