    "message": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "schema_version": {
      "const": "reconcile/error/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "code",
    "message",
    "details"
  ],
  "title": "ApiError",
  "type": "object"
