      "required": [
        "status",
        "model_call_count",
        "input_token_count",
        "output_token_count",
        "total_token_count",
        "input_cost_nano_units_per_token",
        "output_cost_nano_units_per_token",
        "model_cost_nano_units",
        "live_vertex_backed"
      ],
      "title": "RecoveryQualificationModelUsage",
      "type": "object"
    },
    "RecoveryQualificationModelUsageStatus": {
      "enum": [
        "NOT_APPLICABLE",
        "SCRIPTED",
        "MEASURED",
        "UNAVAILABLE"
      ],
      "title": "RecoveryQualificationModelUsageStatus",
      "type": "string"
    },
    "RecoveryQualificationPermitCoverage": {
      "additionalProperties": false,
      "properties": {
        "continue_case_count": {
          "maximum": 100,
          "minimum": 1,
          "title": "Continue Case Count",
          "type": "integer"
        },
        "no_permit_case_count": {
          "maximum": 100,
          "minimum": 1,
          "title": "No Permit Case Count",
          "type": "integer"
        },
        "retry_case_count": {
          "maximum": 100,
          "minimum": 1,
          "title": "Retry Case Count",
          "type": "integer"
        }
      },
      "required": [
        "continue_case_count",
        "retry_case_count",
        "no_permit_case_count"
      ],
      "title": "RecoveryQualificationPermitCoverage",
      "type": "object"
    },
    "RecoveryQualificationPolicy": {
      "enum": [
        "blind-retry",
        "blind-abort",
        "fixed",
        "adaptive"
      ],
      "title": "RecoveryQualificationPolicy",
      "type": "string"
    },
    "RecoveryQualificationProviderMutations": {
      "additionalProperties": false,
      "properties": {
        "outbound_call_count": {
          "maximum": 48,
          "minimum": 0,
          "title": "Outbound Call Count",
          "type": "integer"
        },
        "promote_calls": {
          "maximum": 16,
          "minimum": 0,
          "title": "Promote Calls",
          "type": "integer"
        },
        "record_calls": {
          "maximum": 16,
          "minimum": 0,
          "title": "Record Calls",
          "type": "integer"
        },
        "stage_calls": {
          "maximum": 16,
          "minimum": 0,
          "title": "Stage Calls",
          "type": "integer"
        }
      },
      "required": [
        "stage_calls",
        "promote_calls",
        "record_calls",
        "outbound_call_count"
      ],
      "title": "RecoveryQualificationProviderMutations",
      "type": "object"
    },
    "RecoveryQualificationResolution": {
      "enum": [
        "CONTINUE",
        "RETRY",
        "COMPLETED",
        "ESCALATE",
        "ABORT"
      ],
      "title": "RecoveryQualificationResolution",
      "type": "string"
    },
    "RecoveryQualificationStorageBackend": {
      "enum": [
        "sqlite",
        "firestore"
      ],
      "title": "RecoveryQualificationStorageBackend",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_format": {
      "const": "proof-to-permit-qualification-v1",
      "title": "Bundle Format",
      "type": "string"
    },
    "case_count": {
      "const": 100,
      "title": "Case Count",
      "type": "integer"
    },
    "case_proofs": {
      "items": {
        "$ref": "#/$defs/RecoveryQualificationCaseProof"
      },
      "maxItems": 100,
      "minItems": 100,
      "title": "Case Proofs",
      "type": "array"
    },
    "environment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Sha256",
      "type": "string"
    },
    "false_permit_count": {
      "maximum": 400,
      "minimum": 0,
      "title": "False Permit Count",
      "type": "integer"
    },
    "firestore_case_count": {
      "maximum": 100,
      "minimum": 1,
      "title": "Firestore Case Count",
      "type": "integer"
    },
    "lane_result_count": {
      "const": 400,
      "title": "Lane Result Count",
      "type": "integer"
    },
    "lane_results": {
      "items": {
        "$ref": "#/$defs/RecoveryQualificationLaneResult"
      },
      "maxItems": 400,
      "minItems": 400,
      "title": "Lane Results",
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "permit_coverage": {
      "$ref": "#/$defs/RecoveryQualificationPermitCoverage"
    },
    "replay_parity_case_count": {
      "maximum": 100,
      "minimum": 0,
      "title": "Replay Parity Case Count",
      "type": "integer"
    },
    "restart_case_count": {
      "maximum": 20,
      "minimum": 0,
      "title": "Restart Case Count",
      "type": "integer"
    },
    "restart_valid_count": {
      "maximum": 20,
      "minimum": 0,
      "title": "Restart Valid Count",
      "type": "integer"
    },
    "safety_passed": {
      "title": "Safety Passed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "reconcile/recovery-qualification-results/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sqlite_case_count": {
      "maximum": 100,
      "minimum": 1,
      "title": "Sqlite Case Count",
      "type": "integer"
    },
    "suite_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Suite Id",
      "type": "string"
    },
    "witness_case_count": {
      "maximum": 100,
      "minimum": 1,
      "title": "Witness Case Count",
      "type": "integer"
    },
    "witness_replay_valid_count": {
      "maximum": 100,
      "minimum": 0,
      "title": "Witness Replay Valid Count",
      "type": "integer"
    },
    "wrong_hypothesis_decision_divergence_count": {
      "maximum": 300,
      "minimum": 0,
      "title": "Wrong Hypothesis Decision Divergence Count",
      "type": "integer"
    },
    "wrong_hypothesis_permit_divergence_count": {
      "maximum": 300,
      "minimum": 0,
      "title": "Wrong Hypothesis Permit Divergence Count",
      "type": "integer"
    },
    "wrong_hypothesis_replay_count": {
      "maximum": 300,
      "minimum": 0,
      "title": "Wrong Hypothesis Replay Count",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "bundle_format",
    "suite_id",
    "manifest_sha256",
    "environment_sha256",
    "lane_results",
    "case_proofs",
    "case_count",
    "lane_result_count",
    "false_permit_count",
    "replay_parity_case_count",
    "wrong_hypothesis_replay_count",
    "wrong_hypothesis_decision_divergence_count",
    "wrong_hypothesis_permit_divergence_count",
    "witness_case_count",
    "witness_replay_valid_count",
    "restart_case_count",
    "restart_valid_count",
    "permit_coverage",
    "sqlite_case_count",
    "firestore_case_count",
    "safety_passed"
  ],
  "title": "RecoveryQualificationResults",
  "type": "object"
}
