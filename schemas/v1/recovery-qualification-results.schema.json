{
  "$defs": {
    "PermitAction": {
      "enum": [
        "CONTINUE",
        "RETRY"
      ],
      "title": "PermitAction",
      "type": "string"
    },
    "RecoveryQualificationCaseProof": {
      "additionalProperties": false,
      "properties": {
        "adaptive_decision_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adaptive Decision Sha256",
          "type": "string"
        },
        "adaptive_permit_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Adaptive Permit Sha256"
        },
        "admitted_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Admitted Evidence Sha256",
          "type": "string"
        },
        "archetype_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Archetype Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "decision_replay_parity": {
          "title": "Decision Replay Parity",
          "type": "boolean"
        },
        "deterministic_permit_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermitAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "deterministic_resolution": {
          "$ref": "#/$defs/RecoveryQualificationResolution"
        },
        "duplicated_witness_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duplicated Witness Sha256"
        },
        "fixed_decision_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fixed Decision Sha256",
          "type": "string"
        },
        "fixed_permit_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fixed Permit Sha256"
        },
        "permit_replay_parity": {
          "title": "Permit Replay Parity",
          "type": "boolean"
        },
        "reordered_witness_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reordered Witness Sha256"
        },
        "restart_decision_valid": {
          "title": "Restart Decision Valid",
          "type": "boolean"
        },
        "restart_exercised": {
          "title": "Restart Exercised",
          "type": "boolean"
        },
        "restart_lane_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Restart Lane Sha256"
        },
        "restart_permit_valid": {
          "title": "Restart Permit Valid",
          "type": "boolean"
        },
        "restarted_decision_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Restarted Decision Sha256"
        },
        "restarted_permit_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Restarted Permit Sha256"
        },
        "seed": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sequence": {
          "maximum": 100,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "storage_backend": {
          "$ref": "#/$defs/RecoveryQualificationStorageBackend"
        },
        "witness_duplication_valid": {
          "title": "Witness Duplication Valid",
          "type": "boolean"
        },
        "witness_exercised": {
          "title": "Witness Exercised",
          "type": "boolean"
        },
        "witness_reorder_valid": {
          "title": "Witness Reorder Valid",
          "type": "boolean"
        },
        "witness_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Witness Sha256"
        },
        "wrong_hypothesis_replays": {
          "items": {
            "$ref": "#/$defs/RecoveryQualificationHypothesisReplay"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Wrong Hypothesis Replays",
          "type": "array"
        }
      },
      "required": [
        "sequence",
        "case_id",
        "archetype_id",
        "seed",
        "storage_backend",
        "admitted_evidence_sha256",
        "deterministic_resolution",
        "deterministic_permit_action",
        "fixed_decision_sha256",
        "adaptive_decision_sha256",
        "fixed_permit_sha256",
        "adaptive_permit_sha256",
        "decision_replay_parity",
        "permit_replay_parity",
        "wrong_hypothesis_replays",
        "witness_exercised",
        "witness_sha256",
        "reordered_witness_sha256",
        "duplicated_witness_sha256",
        "witness_reorder_valid",
        "witness_duplication_valid",
        "restart_exercised",
        "restart_lane_sha256",
        "restarted_decision_sha256",
        "restarted_permit_sha256",
        "restart_decision_valid",
        "restart_permit_valid"
      ],
      "title": "RecoveryQualificationCaseProof",
      "type": "object"
    },
    "RecoveryQualificationFaultClass": {
      "enum": [
        "no-fault",
        "drop-after-accept",
        "pending",
        "terminal-partial",
        "conflict",
        "absence",
        "provider-unavailable",
        "freshness",
        "suppress-before-dispatch"
      ],
      "title": "RecoveryQualificationFaultClass",
      "type": "string"
    },
    "RecoveryQualificationHypothesisReplay": {
      "additionalProperties": false,
      "properties": {
        "decision_diverged": {
          "title": "Decision Diverged",
          "type": "boolean"
        },
        "observed_decision_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observed Decision Sha256",
          "type": "string"
        },
        "observed_permit_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Permit Sha256"
        },
        "permit_diverged": {
          "title": "Permit Diverged",
          "type": "boolean"
        },
        "proposed_permit_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermitAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_resolution": {
          "$ref": "#/$defs/RecoveryQualificationResolution"
        },
        "provider_name": {
          "const": "gemini",
          "title": "Provider Name",
          "type": "string"
        },
        "variant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "variant_id",
        "provider_name",
        "proposed_resolution",
        "proposed_permit_action",
        "observed_decision_sha256",
        "observed_permit_sha256",
        "decision_diverged",
        "permit_diverged"
      ],
      "title": "RecoveryQualificationHypothesisReplay",
      "type": "object"
    },
    "RecoveryQualificationLaneResult": {
      "additionalProperties": false,
      "properties": {
        "admitted_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Admitted Evidence Sha256",
          "type": "string"
        },
        "ambiguity_witness_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ambiguity Witness Sha256"
        },
        "archetype_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Archetype Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "decision_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Sha256",
          "type": "string"
        },
        "expected_permit_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermitAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "false_permit": {
          "title": "False Permit",
          "type": "boolean"
        },
        "fault_class": {
          "$ref": "#/$defs/RecoveryQualificationFaultClass"
        },
        "issued_permit_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermitAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_usage": {
          "$ref": "#/$defs/RecoveryQualificationModelUsage"
        },
        "permit_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Permit Sha256"
        },
        "policy": {
          "$ref": "#/$defs/RecoveryQualificationPolicy"
        },
        "probe_count": {
          "maximum": 16,
          "minimum": 0,
          "title": "Probe Count",
          "type": "integer"
        },
        "provider_mutations": {
          "$ref": "#/$defs/RecoveryQualificationProviderMutations"
        },
        "resolution": {
          "$ref": "#/$defs/RecoveryQualificationResolution"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "seed": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sequence": {
          "maximum": 400,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "storage_backend": {
          "$ref": "#/$defs/RecoveryQualificationStorageBackend"
        },
        "time_to_sufficient_evidence_ms": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time To Sufficient Evidence Ms"
        },
        "unsupported_probe_count": {
          "maximum": 16,
          "minimum": 0,
          "title": "Unsupported Probe Count",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "case_id",
        "archetype_id",
        "seed",
        "policy",
        "storage_backend",
        "fault_class",
        "admitted_evidence_sha256",
        "decision_sha256",
        "resolution",
        "expected_permit_action",
        "issued_permit_action",
        "permit_sha256",
        "false_permit",
        "probe_count",
        "unsupported_probe_count",
        "resolved",
        "provider_mutations",
        "model_usage",
        "ambiguity_witness_sha256"
      ],
      "title": "RecoveryQualificationLaneResult",
      "type": "object"
    },
    "RecoveryQualificationModelUsage": {
      "additionalProperties": false,
      "properties": {
        "input_cost_nano_units_per_token": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Input Cost Nano Units Per Token",
          "type": "integer"
        },
        "input_token_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Input Token Count",
          "type": "integer"
        },
        "live_vertex_backed": {
          "title": "Live Vertex Backed",
          "type": "boolean"
        },
        "model_call_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Model Call Count",
          "type": "integer"
        },
        "model_cost_nano_units": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Model Cost Nano Units",
          "type": "integer"
        },
        "model_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "output_cost_nano_units_per_token": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Output Cost Nano Units Per Token",
          "type": "integer"
        },
        "output_token_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Output Token Count",
          "type": "integer"
        },
        "provider_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Name"
        },
        "status": {
          "$ref": "#/$defs/RecoveryQualificationModelUsageStatus"
        },
        "total_token_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Total Token Count",
          "type": "integer"
        }
