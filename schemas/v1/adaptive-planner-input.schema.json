        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "operation_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "#/$defs/EvidenceReason"
        }
      },
      "required": [
        "evidence_id",
        "capability_name",
        "capability_version",
        "reason",
        "effect_assertions",
        "operation_status"
      ],
      "title": "PlannerAdmittedEvidence",
      "type": "object"
    },
    "PlannerCapability": {
      "additionalProperties": false,
      "properties": {
        "argument_schema": {
          "$ref": "#/$defs/JsonObject"
        },
        "cost_units": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Cost Units",
          "type": "integer"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "read_only": {
          "const": true,
          "title": "Read Only",
          "type": "boolean"
        },
        "remaining_invocations": {
          "maximum": 64,
          "minimum": 0,
          "title": "Remaining Invocations",
          "type": "integer"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "description",
        "read_only",
        "argument_schema",
        "cost_units",
        "remaining_invocations"
      ],
      "title": "PlannerCapability",
      "type": "object"
    },
