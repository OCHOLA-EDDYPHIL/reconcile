{
  "$defs": {
    "ArgumentsObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "maxProperties": 64,
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "$ref": "#/$defs/ArgumentsObject"
    },
    "capability_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Capability Name",
      "type": "string"
    },
    "capability_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Capability Version",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "relevant_effect_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Relevant Effect Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "reconcile/probe-request/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "capability_name",
    "capability_version",
    "relevant_effect_ids",
    "rationale"
  ],
  "title": "ProbeRequest",
  "type": "object"
}
