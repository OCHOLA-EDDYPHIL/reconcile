{
  "$defs": {
    "RecoveryQualificationAggregateMetrics": {
      "additionalProperties": false,
      "properties": {
        "input_token_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Input Token Count",
          "type": "integer"
        },
        "lane_count": {
          "const": 100,
          "title": "Lane Count",
          "type": "integer"
        },
        "median_probe_count_x2": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Median Probe Count X2",
          "type": "integer"
        },
        "median_time_to_sufficient_evidence_ms_x2": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Median Time To Sufficient Evidence Ms X2",
          "type": "integer"
        },
        "model_call_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Model Call Count",
          "type": "integer"
        },
        "model_cost_nano_units": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Model Cost Nano Units",
          "type": "integer"
        },
        "output_token_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Output Token Count",
          "type": "integer"
        },
        "policy": {
          "$ref": "#/$defs/RecoveryQualificationPolicy"
        },
        "provider_mutation_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Provider Mutation Count",
          "type": "integer"
        },
        "resolution_rate_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Resolution Rate Basis Points",
          "type": "integer"
        },
        "resolved_count": {
          "maximum": 100,
          "minimum": 0,
          "title": "Resolved Count",
          "type": "integer"
        },
        "total_probe_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Total Probe Count",
          "type": "integer"
        },
        "total_time_to_sufficient_evidence_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Total Time To Sufficient Evidence Ms",
          "type": "integer"
        },
        "total_token_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Total Token Count",
          "type": "integer"
        },
        "unsupported_probe_count": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Unsupported Probe Count",
          "type": "integer"
        }
      },
      "required": [
        "policy",
        "lane_count",
        "total_probe_count",
        "median_probe_count_x2",
        "total_time_to_sufficient_evidence_ms",
        "median_time_to_sufficient_evidence_ms_x2",
        "unsupported_probe_count",
        "resolved_count",
        "resolution_rate_basis_points",
        "provider_mutation_count",
        "model_call_count",
        "input_token_count",
        "output_token_count",
        "total_token_count",
        "model_cost_nano_units"
      ],
      "title": "RecoveryQualificationAggregateMetrics",
      "type": "object"
    },
    "RecoveryQualificationExecutionBasis": {
      "enum": [
        "scripted",
        "live-vertex"
      ],
      "title": "RecoveryQualificationExecutionBasis",
      "type": "string"
    },
    "RecoveryQualificationPolicy": {
      "enum": [
        "blind-retry",
        "blind-abort",
        "fixed",
        "adaptive"
      ],
      "title": "RecoveryQualificationPolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adaptive_efficiency_threshold_basis_points": {
      "const": 2500,
      "title": "Adaptive Efficiency Threshold Basis Points",
      "type": "integer"
    },
    "adaptive_efficiency_threshold_met": {
      "title": "Adaptive Efficiency Threshold Met",
      "type": "boolean"
    },
    "bundle_format": {
      "const": "proof-to-permit-qualification-v1",
      "title": "Bundle Format",
      "type": "string"
    },
    "environment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Sha256",
      "type": "string"
    },
    "execution_basis": {
      "$ref": "#/$defs/RecoveryQualificationExecutionBasis"
    },
    "lanes": {
      "items": {
        "$ref": "#/$defs/RecoveryQualificationAggregateMetrics"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Lanes",
      "type": "array"
    },
    "live_vertex_model_usage_measured": {
      "title": "Live Vertex Model Usage Measured",
      "type": "boolean"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "median_probe_reduction_basis_points": {
      "maximum": 9223372036854775807,
      "minimum": -9223372036854775807,
      "title": "Median Probe Reduction Basis Points",
      "type": "integer"
    },
    "median_probe_reduction_formula": {
      "const": "(fixed_median_probe_count_x2-adaptive_median_probe_count_x2)*10000//fixed_median_probe_count_x2",
      "title": "Median Probe Reduction Formula",
      "type": "string"
    },
    "results_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Results Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "reconcile/recovery-qualification-comparison/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_id": {
      "const": "proof-to-permit-qualification-v1",
      "title": "Suite Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "bundle_format",
    "suite_id",
    "manifest_sha256",
    "environment_sha256",
    "results_sha256",
    "lanes",
    "median_probe_reduction_formula",
    "median_probe_reduction_basis_points",
    "adaptive_efficiency_threshold_basis_points",
    "adaptive_efficiency_threshold_met",
    "execution_basis",
    "live_vertex_model_usage_measured"
  ],
  "title": "RecoveryQualificationComparison",
  "type": "object"
}
