{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lazarus:schema:evidence-packet:v1",
  "title": "Lazarus evidence packet contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "arm",
    "facts",
    "derivations",
    "semantic",
    "advisory",
    "unknowns",
    "blockers",
    "recovery",
    "human_decision_state",
    "semantic_status"
  ],
  "properties": {
    "schema_version": {"const": "lazarus.evidence-packet/v1"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "arm": {"$ref": "#/$defs/identifier"},
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "derivations": {
      "type": "array",
      "items": {"$ref": "#/$defs/derivation"}
    },
    "semantic": {"$ref": "#/$defs/semantic_resolution"},
    "advisory": {
      "type": "array",
      "items": {"$ref": "#/$defs/advisory"}
    },
    "unknowns": {
      "type": "array",
      "items": {"$ref": "#/$defs/unknown"}
    },
    "blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/blocker"}
    },
    "recovery": {"$ref": "#/$defs/recovery_result"},
    "human_decision_state": {
      "enum": ["ready_for_human_decision", "blocked", "needs_confirmation"]
    },
    "semantic_status": {
      "enum": ["not_requested", "unavailable", "available"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "semantic_status": {"const": "not_requested"}
        }
      },
      "then": {
        "properties": {
          "semantic": {
            "properties": {
              "admitted": {"maxItems": 0},
              "rejected": {"maxItems": 0},
              "abstained": {"const": false},
              "requested_evidence": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "semantic_status": {"const": "unavailable"}
        }
      },
      "then": {
        "properties": {
          "semantic": {
            "properties": {
              "admitted": {"maxItems": 0},
              "abstained": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "human_decision_state": {"const": "ready_for_human_decision"}
        }
      },
      "then": {
        "properties": {
          "blockers": {"maxItems": 0},
          "unknowns": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "human_decision_state": {"const": "blocked"}
        }
      },
      "then": {
        "properties": {
          "blockers": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "kind", "value", "source"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/identifier"},
        "value": true,
        "source": {"type": "string", "minLength": 1}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation_id", "kind", "value", "evidence_refs"],
      "properties": {
        "derivation_id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/identifier"},
        "value": true,
        "evidence_refs": {"$ref": "#/$defs/string_array"}
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisory_id", "kind", "value", "evidence_refs"],
      "properties": {
        "advisory_id": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/identifier"},
        "value": true,
        "evidence_refs": {"$ref": "#/$defs/string_array"}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"$ref": "#/$defs/identifier"},
        "operation_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_id",
        "code",
        "message",
        "evidence_refs",
        "decision_effect"
      ],
      "properties": {
        "blocker_id": {"$ref": "#/$defs/identifier"},
        "code": {"$ref": "#/$defs/identifier"},
        "message": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "allOf": [
            {"$ref": "#/$defs/string_array"},
            {"minItems": 1}
          ]
        },
        "decision_effect": {"const": "block"}
      }
    },
    "semantic_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted", "rejected", "abstained", "requested_evidence"],
      "properties": {
        "admitted": {
          "type": "array",
          "items": {"$ref": "#/$defs/admitted_proposal"}
        },
        "rejected": {
          "type": "array",
          "items": {"$ref": "#/$defs/rejection"}
        },
        "abstained": {"type": "boolean"},
        "requested_evidence": {"$ref": "#/$defs/string_array"}
      }
    },
    "admitted_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "relation_type",
        "subject",
        "object",
        "citations",
        "evidence_class"
      ],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/identifier"},
        "relation_type": {"$ref": "#/$defs/relation_type"},
        "subject": {"type": "string", "minLength": 1},
        "object": {"type": "string", "minLength": 1},
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/citation"}
        },
        "probe_id": {"$ref": "#/$defs/probe_id"},
        "evidence_class": {
          "enum": ["candidate_inference", "semantic_proposal"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"relation_type": {"const": "probe_selection"}}
          },
          "then": {"required": ["probe_id"]},
          "else": {"not": {"required": ["probe_id"]}}
        },
        {
          "if": {
            "properties": {
              "relation_type": {
                "enum": ["incident_relevance_advisory", "probe_selection"]
              }
            }
          },
          "then": {
            "properties": {"evidence_class": {"const": "semantic_proposal"}}
          },
          "else": {
            "properties": {"evidence_class": {"const": "candidate_inference"}}
          }
        }
      ]
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "reason_codes"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "reason_codes": {
          "allOf": [
            {"$ref": "#/$defs/string_array"},
            {"minItems": 1}
          ]
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "digest", "start", "end", "quote"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "relation_type": {
      "enum": [
        "intent_effect_contradiction",
        "resource_alias_candidate",
        "conditional_dependency_candidate",
        "owner_candidate",
        "incident_relevance_advisory",
        "probe_selection"
      ]
    },
    "probe_id": {
      "enum": [
        "verify_resource_generation",
        "verify_recovery_scope",
        "verify_owner_record",
        "run_application_canary"
      ]
    },
    "status": {"enum": ["pass", "fail", "unknown"]},
    "recovery_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restore", "canary", "rpo", "rto", "cleanup", "classification", "timing"],
      "properties": {
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "elapsed_ms"],
          "properties": {
            "status": {"$ref": "#/$defs/status"},
            "elapsed_ms": {
              "type": ["number", "null"],
              "minimum": 0
            }
          }
        },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checks"],
          "properties": {
            "status": {"$ref": "#/$defs/status"},
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/canary_check"}
            }
          }
        },
        "rpo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "age_seconds", "objective_seconds"],
          "properties": {
            "status": {"$ref": "#/$defs/status"},
            "age_seconds": {"type": ["number", "null"], "minimum": 0},
            "objective_seconds": {"type": "number", "minimum": 0}
          }
        },
        "rto": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "elapsed_ms", "objective_ms"],
          "properties": {
            "status": {"$ref": "#/$defs/status"},
            "elapsed_ms": {"type": ["number", "null"], "minimum": 0},
            "objective_ms": {"type": "number", "minimum": 0}
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"$ref": "#/$defs/status"}}
        },
        "classification": {"$ref": "#/$defs/status"},
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clock",
            "rto_started_ns",
            "restore_started_ns",
            "restore_completed_ns",
            "rto_completed_ns"
          ],
          "properties": {
            "clock": {"enum": ["monotonic_ns", "unavailable"]},
            "rto_started_ns": {"type": ["integer", "null"], "minimum": 0},
            "restore_started_ns": {"type": ["integer", "null"], "minimum": 0},
            "restore_completed_ns": {"type": ["integer", "null"], "minimum": 0},
            "rto_completed_ns": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      }
    },
    "canary_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "check_type", "status"],
      "properties": {
        "check_id": {"$ref": "#/$defs/identifier"},
        "check_type": {
          "enum": ["integrity", "schema", "required_query", "business_invariant"]
        },
        "status": {"$ref": "#/$defs/status"},
        "assertion_id": {"$ref": "#/$defs/identifier"},
        "expected": true,
        "actual": true
      },
      "dependentRequired": {
        "expected": ["actual"],
        "actual": ["expected"]
      }
    }
  }
}
